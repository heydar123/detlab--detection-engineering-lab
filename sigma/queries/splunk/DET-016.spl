| eval CommandLineCondition3=if(isnotnull(CommandLineMatch3), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch4>(?i)(scrobj\\.dll|/i:\\S*(https?://|\\.sct)))"
| eval CommandLineCondition4=if(isnotnull(CommandLineMatch4), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch5>(?i)\\s/u\\b)"
| eval CommandLineCondition5=if(isnotnull(CommandLineMatch5), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch6>(?i)(/logfile=|/logtoconsole=false))"
| eval CommandLineCondition6=if(isnotnull(CommandLineMatch6), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch7>(?i)\\s/u\\b)"
| eval CommandLineCondition7=if(isnotnull(CommandLineMatch7), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch8>(?i)(/logfile=|/logtoconsole=false))"
| eval CommandLineCondition8=if(isnotnull(CommandLineMatch8), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch9>(?i)\\s/au\\b)"
| eval CommandLineCondition9=if(isnotnull(CommandLineMatch9), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch10>(?i)\\s/au\\b)"
| eval CommandLineCondition10=if(isnotnull(CommandLineMatch10), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch11>(?i)(/(transfer|addfile)\\b.*https?://|/setnotifycmdline\\b))"
| eval CommandLineCondition11=if(isnotnull(CommandLineMatch11), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch12>(?i)(/(transfer|addfile)\\b.*https?://|/setnotifycmdline\\b))"
| eval CommandLineCondition12=if(isnotnull(CommandLineMatch12), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch13>(?i)(-urlcache\\b.*https?://|-decode\\b))"
| eval CommandLineCondition13=if(isnotnull(CommandLineMatch13), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch14>(?i)(-urlcache\\b.*https?://|-decode\\b))"
| eval CommandLineCondition14=if(isnotnull(CommandLineMatch14), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch15>(?i)(javascript:|vbscript:|mshtml[, ]+runhtmlapplication))"
| eval CommandLineCondition15=if(isnotnull(CommandLineMatch15), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch16>(?i)(javascript:|vbscript:|mshtml[, ]+runhtmlapplication))"
| eval CommandLineCondition16=if(isnotnull(CommandLineMatch16), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch17>(?i)/format:\\s*[\\x22\\x27]?(https?://|\\S+\\.xsl))"
| eval CommandLineCondition17=if(isnotnull(CommandLineMatch17), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch18>(?i)/format:\\s*[\\x22\\x27]?(https?://|\\S+\\.xsl))"
| eval CommandLineCondition18=if(isnotnull(CommandLineMatch18), "true", "false")
