-- DET-016 query 1
DeviceProcessEvents
| where (FolderPath endswith "\\mshta.exe" and ProcessCommandLine matches regex "(?i)(https?://|\\.hta\\b|\\.sct\\b|javascript:|vbscript:)") or (ProcessVersionInfoOriginalFileName =~ "mshta.exe" and ProcessCommandLine matches regex "(?i)(https?://|\\.hta\\b|\\.sct\\b|javascript:|vbscript:)") or (FolderPath endswith "\\regsvr32.exe" and ProcessCommandLine matches regex "(?i)(scrobj\\.dll|/i:\\S*(https?://|\\.sct))") or (ProcessVersionInfoOriginalFileName =~ "regsvr32.exe" and ProcessCommandLine matches regex "(?i)(scrobj\\.dll|/i:\\S*(https?://|\\.sct))") or (FolderPath endswith "\\installutil.exe" and (ProcessCommandLine matches regex "(?i)\\s/u\\b" and ProcessCommandLine matches regex "(?i)(/logfile=|/logtoconsole=false)")) or (ProcessVersionInfoOriginalFileName =~ "installutil.exe" and (ProcessCommandLine matches regex "(?i)\\s/u\\b" and ProcessCommandLine matches regex "(?i)(/logfile=|/logtoconsole=false)")) or (FolderPath endswith "\\cmstp.exe" and ProcessCommandLine matches regex "(?i)\\s/au\\b") or (ProcessVersionInfoOriginalFileName =~ "cmstp.exe" and ProcessCommandLine matches regex "(?i)\\s/au\\b") or (FolderPath endswith "\\bitsadmin.exe" and ProcessCommandLine matches regex "(?i)(/(transfer|addfile)\\b.*https?://|/setnotifycmdline\\b)") or (ProcessVersionInfoOriginalFileName =~ "bitsadmin.exe" and ProcessCommandLine matches regex "(?i)(/(transfer|addfile)\\b.*https?://|/setnotifycmdline\\b)") or (FolderPath endswith "\\certutil.exe" and ProcessCommandLine matches regex "(?i)(-urlcache\\b.*https?://|-decode\\b)") or (ProcessVersionInfoOriginalFileName =~ "certutil.exe" and ProcessCommandLine matches regex "(?i)(-urlcache\\b.*https?://|-decode\\b)") or (FolderPath endswith "\\rundll32.exe" and ProcessCommandLine matches regex "(?i)(javascript:|vbscript:|mshtml[, ]+runhtmlapplication)") or (ProcessVersionInfoOriginalFileName =~ "rundll32.exe" and ProcessCommandLine matches regex "(?i)(javascript:|vbscript:|mshtml[, ]+runhtmlapplication)") or (FolderPath endswith "\\wmic.exe" and ProcessCommandLine matches regex "(?i)/format:\\s*[\\x22\\x27]?(https?://|\\S+\\.xsl)") or (ProcessVersionInfoOriginalFileName =~ "wmic.exe" and ProcessCommandLine matches regex "(?i)/format:\\s*[\\x22\\x27]?(https?://|\\S+\\.xsl)")
