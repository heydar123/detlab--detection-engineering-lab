-- DET-018 query 1
DeviceProcessEvents
| where (FolderPath endswith "\\netsh.exe" and (ProcessCommandLine matches regex "(?i)advfirewall\\s+firewall\\s+add\\s+rule" and ProcessCommandLine matches regex "(?i)dir=in\\b" and ProcessCommandLine matches regex "(?i)action=allow")) or (FolderPath endswith "\\netsh.exe" and ProcessCommandLine matches regex "(?i)advfirewall\\s+set\\s+\\S+\\s+state\\s+off") or (FolderPath endswith "\\netsh.exe" and ProcessCommandLine matches regex "(?i)firewall\\s+set\\s+opmode\\s+(mode=)?disable") or (FolderPath endswith "\\netsh.exe" and ProcessCommandLine matches regex "(?i)interface\\s+portproxy\\s+add") or (ProcessVersionInfoOriginalFileName =~ "netsh.exe" and (ProcessCommandLine matches regex "(?i)advfirewall\\s+firewall\\s+add\\s+rule" and ProcessCommandLine matches regex "(?i)dir=in\\b" and ProcessCommandLine matches regex "(?i)action=allow")) or (ProcessVersionInfoOriginalFileName =~ "netsh.exe" and ProcessCommandLine matches regex "(?i)advfirewall\\s+set\\s+\\S+\\s+state\\s+off") or (ProcessVersionInfoOriginalFileName =~ "netsh.exe" and ProcessCommandLine matches regex "(?i)firewall\\s+set\\s+opmode\\s+(mode=)?disable") or (ProcessVersionInfoOriginalFileName =~ "netsh.exe" and ProcessCommandLine matches regex "(?i)interface\\s+portproxy\\s+add")
