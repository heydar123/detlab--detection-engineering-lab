-- DET-010 query 1
DeviceProcessEvents
| where (FolderPath endswith "\\reg.exe" and ProcessCommandLine matches regex "(?i)\\b(save|export)\\b.*\\bhk(lm|ey_local_machine)\\\\(sam|security|system)\\b") or (ProcessVersionInfoOriginalFileName =~ "reg.exe" and ProcessCommandLine matches regex "(?i)\\b(save|export)\\b.*\\bhk(lm|ey_local_machine)\\\\(sam|security|system)\\b") or (FolderPath endswith "\\ntdsutil.exe" and ProcessCommandLine matches regex "(?i)(ac(tivate)?\\s+i(nstance)?\\s+ntds|\\bifm\\b)") or (ProcessVersionInfoOriginalFileName =~ "ntdsutil.exe" and ProcessCommandLine matches regex "(?i)(ac(tivate)?\\s+i(nstance)?\\s+ntds|\\bifm\\b)") or (FolderPath endswith "\\rundll32.exe" and ProcessCommandLine matches regex "(?i)comsvcs(\\.dll)?[\\x22\\x27]?[,\\s]+(#+0*24|minidump)") or (ProcessVersionInfoOriginalFileName =~ "rundll32.exe" and ProcessCommandLine matches regex "(?i)comsvcs(\\.dll)?[\\x22\\x27]?[,\\s]+(#+0*24|minidump)") or (FolderPath endswith "\\vssadmin.exe" and ProcessCommandLine matches regex "(?i)create\\s+shadow") or (ProcessVersionInfoOriginalFileName =~ "vssadmin.exe" and ProcessCommandLine matches regex "(?i)create\\s+shadow") or (FolderPath endswith "\\esentutl.exe" and ProcessCommandLine matches regex "(?i)ntds\\.dit") or (ProcessVersionInfoOriginalFileName =~ "esentutl.exe" and ProcessCommandLine matches regex "(?i)ntds\\.dit") or ((FolderPath endswith "\\procdump.exe" or FolderPath endswith "\\procdump64.exe") and ProcessCommandLine matches regex "(?i)lsass") or ((ProcessVersionInfoOriginalFileName in~ ("procdump.exe", "procdump64.exe")) and ProcessCommandLine matches regex "(?i)lsass")
